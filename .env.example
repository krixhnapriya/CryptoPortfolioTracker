# CoinGecko API Configuration
# CoinGecko's Public API has rate limits (approx 10-30 requests/min).
# If you have a CoinGecko Demo or Pro API key, provide it below.
# Leave blank to use the free public tier without an API key.
COINGECKO_API_KEY=your_coingecko_api_key_here

# Currency setting (default: inr)
DEFAULT_CURRENCY=inr

# Local Database Path
DATABASE_PATH=data/portfolio.db
